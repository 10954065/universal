# ─── Core ────────────────────────────────────────────────────────────────
# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap,
# auth callbacks and payment redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string. Local: `npm run db:up` starts one on port 5447.
DATABASE_URL="postgresql://utm:utm_local_dev_only@localhost:5447/utm"

# Long random string (32+ chars). Generate: openssl rand -base64 32
# Signs sessions and anti-spam form tokens. NEVER commit the real value.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Email (optional until configured) ───────────────────────────────────
# Resend (https://resend.com). Without a key, submissions are still stored in
# the database and visible in the dashboard, but no emails are sent.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Universal Trinity Ministry <no-reply@example.org>"
# Staff inbox that receives new-enquiry notifications (no prayer content is emailed).
STAFF_NOTIFICATION_EMAIL=""

# ─── Online giving (optional until the ministry approves) ────────────────
# Paystack secret key from the ministry's own Paystack dashboard.
# Server-side only. Never prefix with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=""

# ─── Media uploads ───────────────────────────────────────────────────────
# Vercel Blob token. Required on Vercel (its filesystem is read-only).
# Without it, uploads are written to public/uploads (persistent servers only).
BLOB_READ_WRITE_TOKEN=""

# ─── Scheduled jobs ──────────────────────────────────────────────────────
# Bearer token required by /api/cron/retention (prayer-request retention purge).
CRON_SECRET=""

# ─── Analytics (optional, privacy-friendly) ──────────────────────────────
# Set to the site's domain to enable Plausible. Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ─── Development only ────────────────────────────────────────────────────
# true = seed clearly-labelled SAMPLE sermons/events for local development.
# Never set in production.
SEED_SAMPLE_CONTENT="false"
